# Server listen port; compose.yml maps host 3000 to this exact value —
# don't change without updating compose.yml too (D-07).
PORT=3000

# Path relative to the app's working directory (/app in the container).
# Combined with compose.yml's ./data:/app/data bind mount, this persists
# the SQLite db plus its WAL sidecar files across restarts and updates
# (D-03).
DB_PATH=./data/my-bar.db

# Disables the dev-only CORS grant in apps/server/src/index.ts.
NODE_ENV=production

# Required, server-side only, never sent to the browser. Get a key from
# https://console.anthropic.com/ — the app starts fine without a real
# value filled in during this phase; it is consumed by AI features added
# later.
ANTHROPIC_API_KEY=your_api_key_here
